# Supabase project settings (Project Settings → API).
# Use the publishable (or legacy anon) key. It's safe in a browser app;
# row-level security protects the data. Leave both empty for demo mode.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
